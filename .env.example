# =================================
# Reputation OS — Environment
# =================================

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reputation_os

# Auth
AUTH_SECRET=change-me-to-a-random-secret-min-32-characters-long
SESSION_EXPIRY_SECONDS=604800

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
FEEDBACK_RATE_LIMIT_MAX=10
