# ============================================================
# Reputation OS — Production Environment Configuration
# ============================================================

# Database (Neon / Supabase Serverless PostgreSQL - Free Tier)
# Ensure ?sslmode=require is appended for cloud PostgreSQL
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Sessions
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=generate_a_secure_random_64_character_hex_secret_for_production
SESSION_EXPIRY_SECONDS=604800

# Server Runtime
PORT=3000
NODE_ENV=production

# Cross-Origin Resource Sharing (CORS)
# Set to your exact production frontend domain (No trailing slash)
CORS_ORIGIN=https://reputationos.vercel.app

# Rate Limiting & Anti-Abuse
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
FEEDBACK_RATE_LIMIT_MAX=10

# Extensibility Providers (Defaults operate at ₹0 cost)
AI_PROVIDER=noop
MESSAGING_PROVIDER=console
BILLING_PROVIDER=free_tier
EMAIL_PROVIDER=console
